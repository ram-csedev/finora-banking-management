# CockroachDB Cloud Connection String (Serverless / Dedicated)
DATABASE_URL=postgresql://<user>:<password>@<cluster-host>:26257/finora_da3?sslmode=verify-full

# Path to the CockroachDB Cloud Root CA Certificate
DB_SSL_ROOT_CERT=certs/root.crt

# Backend Server Listening Port (Default: 5000)
PORT=5000
